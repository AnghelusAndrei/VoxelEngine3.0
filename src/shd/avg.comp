#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Blend weights this frame's mean by its sample count `pixels` (coverage-proportional
// convergence). Once the sample count reaches its cap it behaves as an EMA with that
// window. This is what feeds the irradiance-cache feedback in shade.comp.

#include "lbuffer.glsl"

layout(std430, binding = SSBO_UNIQUE_LIST_BINDING) readonly buffer UniqueList { uvec4 entries[]; } uniqueList;
layout(std430, binding = SSBO_UNIQUE_COUNT_BINDING) readonly buffer UniqueCnt  { uint uniqueCount; };
layout(std430, binding = SSBO_ACCUM_DIFFUSE_BINDING) coherent buffer AccumDiffuse { uvec4 accum[]; } accumDiffuse;
layout(std430, binding = SSBO_ACCUM_SPECULAR_BINDING) coherent buffer AccumSpecular { uvec4 accum[]; } accumSpecular;

uniform uint nDiffMax;   // diffuse temporal window (long)
uniform uint nSpecMax;   // specular temporal window (short)

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= uniqueCount) return;

    uint slot = uniqueList.entries[gid].z;
    if (slot == LB_NO_SLOT) return;
    uint sb = linearSlotToBase(slot);

    uint pixels = accumDiffuse.accum[gid].w;
    if (pixels == 0u) return;                       // not sampled this frame → keep history

    float inv = 1.0 / (float(pixels) * ACCUM_SCALE);
    vec3 dframe = vec3(accumDiffuse.accum[gid].x,
                       accumDiffuse.accum[gid].y,
                       accumDiffuse.accum[gid].z) * inv;
    vec3 sframe = vec3(accumSpecular.accum[gid].x,
                       accumSpecular.accum[gid].y,
                       accumSpecular.accum[gid].z) * inv;

    uint samples = lbuf.data[sb + LB_SAMPLES];
    float nd = float(samples & 0xFFFFu);
    float ns = float(samples >> 16u);
    float pf = float(pixels);

    vec3 dch = unpackRGB9E5(lbuf.data[sb + LB_DIFFUSE]);
    vec3 sch = unpackRGB9E5(lbuf.data[sb + LB_SPECULAR]);

    float lframe = log(max(luminance(dframe), LUM_FLOOR));
    float m = uintBitsToFloat(lbuf.data[sb + LB_LUMINANCE]);
    float v = uintBitsToFloat(lbuf.data[sb + LB_VARIANCE]);

    if (nd == 0.0) {
        // Fresh slot
        m = lframe;
        v = 0.0;
    } else {
        // Clamped at BOTH ends: the ceiling keeps a heavily-covered voxel from
        // collapsing the update to zero, the floor keeps a sparsely-covered one from
        // freezing its variance for thousands of frames (constants.glsl).
        const float av    = clamp(pf / (nd + pf), VAR_ALPHA_MIN, VAR_ALPHA_MAX);
        const float delta = lframe - m;
        m += av * delta;
        v  = max((1.0 - av) * (v + av * delta * delta), 0.0);
    }

    dch = (dch * nd + dframe * pf) / (nd + pf);     // sample-capped running average
    sch = (sch * ns + sframe * pf) / (ns + pf);

    // Variance-adaptive window. 
    uint window = clamp(uint(float(nDiffMax) / (v + VAR_WINDOW_EPS)), VAR_WINDOW_MIN, LB_COUNT_MAX);
    uint ndNew = min((samples & 0xFFFFu) + pixels, window);
    uint nsNew = min((samples >> 16u)   + pixels, min(nSpecMax, LB_COUNT_MAX));

    lbuf.data[sb + LB_DIFFUSE]  = packRGB9E5(dch);
    lbuf.data[sb + LB_SPECULAR] = packRGB9E5(sch);
    lbuf.data[sb + LB_SAMPLES]  = (ndNew & 0xFFFFu) | (nsNew << 16u);
    lbuf.data[sb + LB_LUMINANCE] = floatBitsToUint(m);
    lbuf.data[sb + LB_VARIANCE]  = floatBitsToUint(v);

    // clear per-frame accumulators for next frame
    accumDiffuse.accum[gid] = uvec4(0u);
    accumSpecular.accum[gid] = uvec4(0u);
}
