#version 460 core
#extension GL_KHR_shader_subgroup_basic      : require
#extension GL_KHR_shader_subgroup_ballot     : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 8, local_size_y = 8) in;

// Deferred gbuffer writer + per-voxel deduplication. DDA-traces the octree,
// stores the hit voxel identity in the gbuffer, claims each visible octree slot
// once (claim bitfield, atomicOr) and wave-compacts the unique hits into
// uniqueVoxelList for the lbuffer_claim pass.
layout(binding = 0, rgba32ui) writeonly uniform uimage2D gbufferTexture;

layout(std430, binding = 0) readonly buffer OctreeBuffer { uvec2 nodes[]; } octree;

// claim bitfield — 1 bit per octree slot (binding = SSBO_CLAIM_BINDING).
layout(std430, binding = 1) coherent buffer ClaimBuffer { uint bits[]; } claimbuf;
// dedup output: uvec4 {key.xy, claimedSlot, spare}; claimedSlot pre-set to NO_SLOT.
layout(std430, binding = 3) writeonly buffer UniqueList { uvec4 entries[]; } uniqueList;
layout(std430, binding = 4) coherent  buffer UniqueCnt  { uint uniqueCount; };

uniform uint octreeDepth;
uniform ivec2 screenResolution;
uniform uint primary_raystop;

layout(std140, binding = 0) uniform CameraUniform {
    vec4 position;
    vec4 cameraPlane, cameraPlaneRight, cameraPlaneUp;
} camera;

#define NO_SLOT 0xFFFFFFFFu

#include "gbuffer.glsl"
#include "internal.glsl"

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    bool inBoundsPix = (pix.x < screenResolution.x && pix.y < screenResolution.y);

    bool needsAppend = false;
    uvec4 gkey = uvec4(0u);

    if (inBoundsPix) {
        vec2 ndc = vec2(
            (float(pix.x) + 0.5) / float(screenResolution.x) * 2.0 - 1.0,
            (float(pix.y) + 0.5) / float(screenResolution.y) * 2.0 - 1.0
        );
        vec3 direction = normalize(
            camera.cameraPlane.xyz
            + ndc.x * camera.cameraPlaneRight.xyz
            - ndc.y * camera.cameraPlaneUp.xyz
        );

        octreeLength = 1u << octreeDepth;

        ray_t ray;
        ray.origin = camera.position.xyz;
        ray.direction = direction;
        ray.inverted_direction = 1.0 / direction;

        hit_t voxel = Raycast(ray, octreeDepth, primary_raystop, 4.0, true);

        if (voxel.hit && voxel.material != 0u) {
            uint level = max(1u, octreeDepth - uint(findMSB(voxel.size)));
            gkey = PackGBuffer(voxel.position, level, voxel.material, voxel.version, voxel.steps);
            imageStore(gbufferTexture, pix, gkey);

            // Claim this octree slot once per frame (dedup TAS).
            uint w = voxel.id >> 5u, b = 1u << (voxel.id & 31u);
            needsAppend = (atomicOr(claimbuf.bits[w], b) & b) == 0u;
        } else {
            imageStore(gbufferTexture, pix, uvec4(0u, 0u, 0u, voxel.steps));   // miss (keep steps for STEPS mode)
        }
    }

    // Wave-compacted append of unique voxels (operates over active lanes).
    uvec4 ballot   = subgroupBallot(needsAppend);
    uint  waveCnt  = subgroupBallotBitCount(ballot);
    uint  waveBase = 0u;
    if (subgroupElect() && waveCnt > 0u)
        waveBase = atomicAdd(uniqueCount, waveCnt);
    waveBase = subgroupBroadcastFirst(waveBase);
    if (needsAppend) {
        uint off = subgroupBallotExclusiveBitCount(ballot);
        uniqueList.entries[waveBase + off] = uvec4(gkey.x, gkey.y, NO_SLOT, 0u);
    }
}
