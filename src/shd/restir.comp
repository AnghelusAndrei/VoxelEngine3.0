#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ReSTIR DI — per-voxel light reservoir (architecture/RESTIR.md §E1). One thread per visible voxel
// (over uniqueVoxelList, like normal.comp). It draws RIS_M unshadowed light candidates (light-tree
// descent), weighted-resamples to one, then TEMPORALLY merges this same voxel's previous-frame
// reservoir (which persists in the slot across frames — the lBuffer IS the world-space reservoir
// grid). Stores {y, W, M} in D14/D15.
//
// The reservoir is UNSHADOWED: shade.comp casts the per-pixel area-face shadow ray and applies
// visibility + the MIS weight. Keeping visibility per-pixel preserves area-face partial visibility
// and keeps the estimator unbiased (RIS with any positive target + a final V test is unbiased;
// temporal reuse at the SAME world voxel is the same integration domain — no Jacobian, no bias).

layout(std430, binding = 0) readonly buffer OctreeBuffer { uvec2 nodes[]; } octree;
layout(std430, binding = 3) readonly buffer UniqueList   { uvec4 entries[]; } uniqueList;
layout(std430, binding = 4) readonly buffer UniqueCnt    { uint  uniqueCount; };

uniform uint octreeDepth;
uniform uint frameIndex;     // RNG decorrelation: fresh candidates each frame, else temporal reuse buys nothing
uniform uint restirMCap;     // prev-frame M clamp (temporal confidence cap; 0 = no temporal reuse)

struct Material {
    vec4 color, specularColor;
    float roughness, specular, metallic;
    bool emissive;
    float emissiveIntensity;
};
layout(std140, binding = 1) uniform MaterialUniform { Material material[127]; };

#include "lbuffer.glsl"
#include "lighttree.glsl"
#include "nee.glsl"

#define RIS_M 8

uint  pcg(inout uint s){ s = s*747796405u + 2891336453u; uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u; return (w >> 22u) ^ w; }
float rnd(inout uint s){ return float(pcg(s)) * (1.0 / 4294967296.0); }

// Octree leaf material at p (0 = air). Descends to the first leaf (handles coarse leaves).
uint octMaterialAt(uvec3 p){
    uvec2 root = octree.nodes[0];
    if ((root.x & 1u) == 0u) return (root.x >> 1u) & 0x7Fu;     // degenerate leaf root
    uint L = 1u << octreeDepth, block = root.y;
    for (uint d = 1u; d <= octreeDepth; d++){
        uint p2  = L >> d;
        uint idx = (uint(bool(p.x & p2)) << 2u) | (uint(bool(p.y & p2)) << 1u) | uint(bool(p.z & p2));
        uvec2 n = octree.nodes[block + idx];
        if (n.x == 0u && n.y == 0u) return 0u;
        if ((n.x & 1u) == 0u)       return (n.x >> 1u) & 0x7Fu;
        block = n.y;
    }
    return 0u;
}

void main(){
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= uniqueCount) return;

    uvec4 entry = uniqueList.entries[gid];
    uint  slot  = entry.z;
    if (slot == LB_NO_SLOT) return;                              // never seated this frame
    uint sb = linearSlotToBase(slot);

    uvec2 key   = uvec2(entry.x, entry.y);
    uvec3 pos   = uvec3(key.x & 0xFFFFu, key.x >> 16u, key.y & 0xFFFFu);
    uint  level = (key.y >> 16u) & 0xFFu;

    // Skip near-metals (resolve discards diffuse by (1-metallic)) and voxels whose normal is not yet
    // valid this frame — clear the reservoir so shade adds no NEE for them.
    uint d3 = lbuf.data[sb + LB_NORMAL];
    if (material[octMaterialAt(pos)].metallic >= 0.99 || (d3 & NORMAL_UPDATE_BIT) != 0u){
        lbuf.data[sb + LB_RESV_LIGHT] = 0u;
        return;
    }
    uint vsize  = 1u << (octreeDepth - level);
    vec3 center = vec3(pos) + float(vsize) * 0.5;
    vec3 N      = normalize(UnpackNormal(d3));

    uint rng = lb_hash(pos.x ^ lb_hash(pos.y ^ lb_hash(pos.z ^ lb_hash(frameIndex)))) | 1u;

    // ---- initial RIS over RIS_M unshadowed candidates (WRS) ----
    float wSum  = 0.0;
    uvec3 yPos  = uvec3(0u);
    float yPhat = 0.0;
    uint  M     = 0u;
    for (int i = 0; i < RIS_M; i++){
        LightSample c = sampleLightTree(rng);
        if (!c.valid || c.pdfDisc <= 0.0) continue;
        M++;
        float pHat = targetPhat(center, N, c.pos, c.size, c.material);
        if (pHat <= 0.0) continue;
        float w = pHat / c.pdfDisc;
        wSum += w;
        if (rnd(rng) * wSum < w){ yPos = c.pos; yPhat = pHat; }
    }

    // ---- temporal reuse: merge the SPATIOTEMPORAL reservoir from last frame (resvSp[slot] = the spatial
    // pass's output, read by shade + folded back HERE → the feedback loop that makes ReSTIR converge fast). ----
    uint rb    = resvSpBase(slot);
    uint prevM = unpackResvM(resvSp.data[rb]);
    if (restirMCap > 0u && prevM > 0u){
        uvec3 prevPos = unpackResvPos(resvSp.data[rb]);
        float prevPdf;
        uint  prevMat = lightLeafLookup(prevPos, prevPdf);       // 0 ⟹ that light no longer exists → drop it
        if (prevMat != 0u){
            float prevW = uintBitsToFloat(resvSp.data[rb + 1u]);
            float pHatP = targetPhat(center, N, prevPos, 1u, prevMat);   // lights are full-depth (size 1)
            uint  prevMc = min(prevM, restirMCap);               // clamp history → bounded responsiveness knob
            float wPrev  = pHatP * prevW * float(prevMc);
            if (wPrev > 0.0){
                wSum += wPrev;
                M    += prevMc;
                if (rnd(rng) * wSum < wPrev){ yPos = prevPos; yPhat = pHatP; }
            }
        }
    }

    // ---- finalize + store the TEMPORAL reservoir into the slot (read by restir_spatial as the snapshot) ----
    float W = (yPhat > 0.0 && M > 0u) ? wSum / (float(M) * yPhat) : 0.0;
    lbuf.data[sb + LB_RESV_LIGHT] = (W > 0.0) ? packResvLight(yPos, min(M, 31u)) : 0u;
    lbuf.data[sb + LB_RESV_W]     = floatBitsToUint(W);
}
