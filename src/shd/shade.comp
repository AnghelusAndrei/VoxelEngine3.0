#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;   // 64 threads => matches internal.glsl gs_stack[*][64]
#include "lbuffer.glsl"

//   1. read the (jittered, downscaled) primary voxel from the virtual gbuffer
//   2. resolve its normal: cached lBuffer normal if present, else a small occupancy
//      kernel (voxelNormal)
//   3. cast 1 cosine-weighted diffuse ray + 1 GGX-VNDF specular ray, each ONE bounce
//      with irradiance-cache feedback — a bounce that hits a cached voxel reads its
//      diffuse radiosity (albedo·diffuseChannel) ≈ all further bounces; sky + emissive
//      voxels are the only direct light. Uncached non-emissive hit contributes 0.
//   4. write incident diffuse and specular outgoing radiance to the virtual
//      images. accum.comp reduces them per-voxel; resolve composites albedo·diffuse+spec.


// Read-write: shade stamps the uniqueVoxelList index into .z's spare bits (gbuffer.glsl)
// so accum can skip the lookup entirely. Each invocation only ever touches its own texel.
layout(binding = 0, rgba32ui) coherent  uniform uimage2D virtualGBuffer;
layout(binding = 1, rgba32f)  writeonly uniform image2D  virtualDiffuse;
layout(binding = 2, rgba32f)  writeonly uniform image2D  virtualSpecular;

layout(std430, binding = SSBO_OCTREE_BINDING) readonly buffer OctreeBuffer { uvec2 nodes[]; } octree;

uniform uint  octreeDepth;
uniform uint  primary_raystop;
uniform uint  frameIndex;
uniform ivec2 virtualSize;

layout(std140, binding = 0) uniform CameraUniform {
    vec4 position;
    vec4 cameraPlane, cameraPlaneRight, cameraPlaneUp;
} camera;

struct Material {
    vec4 color, specularColor;
    float roughness, specular, metallic;
    bool emissive;
    float emissiveIntensity;
};
layout(std430, binding = SSBO_MATERIAL_BINDING) readonly buffer MaterialBuffer { Material material[]; };

uniform samplerCube skybox;

#include "gbuffer.glsl"
#include "internal.glsl"

// ---- RNG (PCG hash) ----
uint pcg(inout uint s){ s = s*747796405u + 2891336453u; uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u; return (w >> 22u) ^ w; }
float rnd(inout uint s){ return float(pcg(s)) * (1.0 / 4294967296.0); }

// ---- GGX VNDF importance sampling (Heitz 2018) ----
float smithG1GGX(float NdotX, float a){ float a2 = a*a; return 2.0*NdotX / (NdotX + sqrt(a2 + (1.0 - a2)*NdotX*NdotX)); }

vec3 sampleGGXVNDF(vec3 N, vec3 V, float roughness, inout uint st){
    float a = max(roughness*roughness, 0.001);
    vec3 up = abs(N.z) < 0.999 ? vec3(0,0,1) : vec3(1,0,0);
    vec3 T  = normalize(cross(up, N));
    vec3 B  = cross(N, T);
    vec3 Vl = vec3(dot(V,T), dot(V,B), dot(V,N));
    vec3 Vh = normalize(vec3(a*Vl.x, a*Vl.y, Vl.z));
    float lensq = Vh.x*Vh.x + Vh.y*Vh.y;
    vec3 T1 = lensq > 0.0 ? vec3(-Vh.y, Vh.x, 0.0) * inversesqrt(lensq) : vec3(1,0,0);
    vec3 T2 = cross(Vh, T1);
    float r1 = rnd(st), r2 = rnd(st);
    float r = sqrt(r1), phi = 6.2831853 * r2;
    float t1 = r*cos(phi), t2 = r*sin(phi);
    float s = 0.5*(1.0 + Vh.z);
    t2 = (1.0 - s)*sqrt(max(1.0 - t1*t1, 0.0)) + s*t2;
    vec3 Nh = t1*T1 + t2*T2 + sqrt(max(0.0, 1.0 - t1*t1 - t2*t2))*Vh;
    vec3 Hl = normalize(vec3(a*Nh.x, a*Nh.y, max(0.0, Nh.z)));
    return normalize(Hl.x*T + Hl.y*B + Hl.z*N);
}

// VNDF throughput = BRDF·NdotL / pdf(L) = F·G1(L) (D, G1(V), 4·NdotV·NdotL cancel).
vec3 ggxThroughput(vec3 N, vec3 V, vec3 L, vec3 H, float roughness, vec3 F0){
    float NdotL = max(dot(N, L), 0.001);
    float VdotH = max(dot(V, H), 0.001);
    vec3  F = F0 + (vec3(1.0) - F0) * pow(1.0 - VdotH, 5.0);
    return F * smithG1GGX(NdotL, roughness*roughness);
}

// Cosine-weighted hemisphere sample around N (pdf = cos/π => Lambertian throughput = albedo).
vec3 cosineHemisphere(vec3 N, inout uint st){
    float r1 = rnd(st), r2 = rnd(st);
    float phi = 6.2831853 * r1;
    float ct  = sqrt(1.0 - r2);     // cos θ
    float sth = sqrt(r2);
    vec3 up = abs(N.z) < 0.999 ? vec3(0,0,1) : vec3(1,0,0);
    vec3 T  = normalize(cross(up, N));
    vec3 B  = cross(N, T);
    return normalize(T*(sth*cos(phi)) + B*(sth*sin(phi)) + N*ct);
}

vec3 sampleSky(vec3 d){ return texture(skybox, d).rgb; }

// ---- occupancy fallback normal (rare: primary voxel not cached / overflow) ----
bool occAt(ivec3 sp, uint lev, uint Lng){
    if (any(lessThan(sp, ivec3(0))) || any(greaterThanEqual(sp, ivec3(int(Lng))))) return false;
    return descendAt(uvec3(sp), lev, Lng).hit;   // octree.glsl; `.hit` => solid, leaf or not
}
// R is the kernel radius: 2 (125 samples) for a primary voxel whose normal is seen
// directly, 1 (27) for a secondary bounce, where the normal only has to pick a
// plausible hemisphere and every sample costs an octree descent.
vec3 kernelNormal(uvec3 pos, uint level, uint vsize, uint Lng, int R){
    vec3 g = vec3(0.0);
    for (int dz = -R; dz <= R; dz++)
    for (int dy = -R; dy <= R; dy++)
    for (int dx = -R; dx <= R; dx++){
        int r2 = dx*dx + dy*dy + dz*dz; if (r2 == 0) continue;
        if (occAt(ivec3(pos) + ivec3(dx,dy,dz)*int(vsize), level, Lng))
            g += vec3(dx,dy,dz) / float(r2);
    }
    return (dot(g,g) > 1e-8) ? normalize(-g) : vec3(0,1,0);
}

// `slot` comes from main's single lookup - the normal and the list index are on the same
// 64 B line, so resolving the slot once serves both.
vec3 voxelNormal(uint slot, uvec3 pos, uint level, uint vsize, uint Lng){
    if (slot != LB_NO_SLOT){
        uint d3 = lbuf.data[linearSlotToBase(slot) + LB_NORMAL];
        if ((d3 & NORMAL_UPDATE_BIT) == 0u) return normalize(UnpackNormal(d3));
    }
    return kernelNormal(pos, level, vsize, Lng, 2);   // cache miss => approximate
}

vec3 traceRadiance(vec3 origin, vec3 dir, inout uint rng){
    ray_t r; r.origin = origin; r.direction = dir; r.inverted_direction = 1.0 / dir;
    hit_t h = Raycast(r, octreeDepth, primary_raystop, 0.0);
    if (!h.hit) return sampleSky(dir);                     // escaped to sky
    Material m = material[h.material];
    vec3 rad = (m.emissive) ? m.color.rgb * m.emissiveIntensity : vec3(0.0);
    uint wlev = max(1u, octreeDepth - uint(findMSB(h.size)));
    // Bounce targets are arbitrary voxels, not necessarily claimed this frame, and any
    // octree upload zeroes the baked offsets - so keep the probe as the correctness net.
    uint slot = findLBuffer(h.position, wlev, h.version, octree.nodes[h.id].x);

    if (slot != LB_NO_SLOT) {                              // cached => indirect feedback
        rad += (1.0 - m.metallic) * m.color.rgb * unpackRGB9E5(lbuf.data[linearSlotToBase(slot) + LB_FDIFFUSE]);
    }
    return rad;
}

void main(){
    ivec2 vp = ivec2(gl_GlobalInvocationID.xy);
    if (vp.x >= virtualSize.x || vp.y >= virtualSize.y) return;

    octreeLength = 1u << octreeDepth;

    uvec4   g  = imageLoad(virtualGBuffer, vp);
    GBuffer gb = UnpackGBuffer(g);
    if (!gb.hit){
        imageStore(virtualDiffuse,  vp, vec4(0.0));
        imageStore(virtualSpecular, vp, vec4(0.0));
        imageStore(virtualGBuffer,  vp, VGSetListIdx(g, VG_LISTIDX_NONE));
        return;
    }

    uint slot    = findLBuffer(gb.pos, gb.level, gb.version, octree.nodes[gb.vid].x);
    uint listIdx = (slot != LB_NO_SLOT) ? lbuf.data[linearSlotToBase(slot) + LB_LISTID]
                                        : VG_LISTIDX_NONE;
    imageStore(virtualGBuffer, vp, VGSetListIdx(g, listIdx));

    uint vsize  = 1u << (octreeDepth - gb.level);
    vec3 center = vec3(gb.pos) + float(vsize) * 0.5;
    vec3 N      = voxelNormal(slot, gb.pos, gb.level, vsize, octreeLength);
    vec3 Vd     = normalize(camera.position.xyz - center);   // toward viewer
    Material m  = material[gb.material];


    uint rng = lb_hash(gb.pos.x ^ lb_hash(gb.pos.y ^ lb_hash(gb.pos.z ^
               lb_hash(frameIndex ^ lb_hash(uint(vp.x) ^ lb_hash(uint(vp.y))))))) | 1u;
    vec3 origin = center + N * (0.87 * float(vsize) + 0.5);

    vec3 Ld      = cosineHemisphere(N, rng);
    vec3 diffuse = traceRadiance(origin, Ld, rng);

    // specular: GGX-VNDF sample, throughput F·G1(L)·specular. Keeps emission (slab stays in reflections).
    vec3 specular = vec3(0.0);
    if (m.specular > 0.01){
        vec3 H  = sampleGGXVNDF(N, Vd, m.roughness, rng);
        vec3 Ls = reflect(-Vd, H);
        if (dot(Ls, N) > 0.0){
            vec3 F0  = mix(vec3(0.04), m.color.rgb, m.metallic);
            vec3 thr = ggxThroughput(N, Vd, Ls, H, m.roughness, F0) * m.specular;
            specular = traceRadiance(origin, Ls, rng) * thr;
        }
    }

    imageStore(virtualDiffuse,  vp, vec4(diffuse,  1.0));
    imageStore(virtualSpecular, vp, vec4(specular, 1.0));
}
