#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;


layout(binding = 0, rgba32ui) readonly uniform uimage2D virtualGBuffer;
layout(binding = 1, rgba32f)  readonly uniform image2D  virtualDiffuse;
layout(binding = 2, rgba32f)  readonly uniform image2D  virtualSpecular;

uniform ivec2 virtualSize;

#include "gbuffer.glsl"

layout(std430, binding = SSBO_ACCUM_DIFFUSE_BINDING) coherent buffer AccumDiffuse { uvec4 accum[]; } accumDiffuse;
layout(std430, binding = SSBO_ACCUM_SPECULAR_BINDING) coherent buffer AccumSpecular { uvec4 accum[]; } accumSpecular;

void main() {
    ivec2 vp = ivec2(gl_GlobalInvocationID.xy);
    if (vp.x >= virtualSize.x || vp.y >= virtualSize.y) return;

    // shade already resolved this texel's accumulator index and stamped it into the gbuffer,
    // so this pass touches neither the lBuffer nor the octree: no slot lookup, no hash.
    uint gid = VGListIdx(imageLoad(virtualGBuffer, vp));
    if (gid == VG_LISTIDX_NONE) return;   // sky, or a voxel that never seated this frame

    vec3 d = clamp(imageLoad(virtualDiffuse,  vp).rgb, 0.0, FIREFLY_CLAMP);
    vec3 s = clamp(imageLoad(virtualSpecular, vp).rgb, 0.0, FIREFLY_CLAMP);

    atomicAdd(accumDiffuse.accum[gid].w, 1u);
    atomicAdd(accumDiffuse.accum[gid].x, uint(d.r * ACCUM_SCALE));
    atomicAdd(accumDiffuse.accum[gid].y, uint(d.g * ACCUM_SCALE));
    atomicAdd(accumDiffuse.accum[gid].z, uint(d.b * ACCUM_SCALE));
    atomicAdd(accumSpecular.accum[gid].x, uint(s.r * ACCUM_SCALE));
    atomicAdd(accumSpecular.accum[gid].y, uint(s.g * ACCUM_SCALE));
    atomicAdd(accumSpecular.accum[gid].z, uint(s.b * ACCUM_SCALE));
}
