#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;


layout(binding = 0, rgba32ui) readonly uniform uimage2D virtualGBuffer;
layout(binding = 1, rgba32f)  readonly uniform image2D  virtualDiffuse;
layout(binding = 2, rgba32f)  readonly uniform image2D  virtualSpecular;

uniform ivec2 virtualSize;

#include "gbuffer.glsl"
#include "lbuffer.glsl"

void main() {
    ivec2 vp = ivec2(gl_GlobalInvocationID.xy);
    if (vp.x >= virtualSize.x || vp.y >= virtualSize.y) return;

    GBuffer gb = UnpackGBuffer(imageLoad(virtualGBuffer, vp));
    if (!gb.hit) return;

    uint slot = probeLBuffer(gb.pos, gb.level, gb.version);   // overflow voxels → skip
    if (slot == LB_NO_SLOT) return;
    uint sb = linearSlotToBase(slot);

    vec3 d = clamp(imageLoad(virtualDiffuse,  vp).rgb, 0.0, FIREFLY_CLAMP);
    vec3 s = clamp(imageLoad(virtualSpecular, vp).rgb, 0.0, FIREFLY_CLAMP);

    atomicAdd(lbuf.data[sb + LB_PIXELS], 1u);
    atomicAdd(lbuf.data[sb + LB_DIFF_ACC + 0u], uint(d.r * ACCUM_SCALE));
    atomicAdd(lbuf.data[sb + LB_DIFF_ACC + 1u], uint(d.g * ACCUM_SCALE));
    atomicAdd(lbuf.data[sb + LB_DIFF_ACC + 2u], uint(d.b * ACCUM_SCALE));
    atomicAdd(lbuf.data[sb + LB_SPEC_ACC + 0u], uint(s.r * ACCUM_SCALE));
    atomicAdd(lbuf.data[sb + LB_SPEC_ACC + 1u], uint(s.g * ACCUM_SCALE));
    atomicAdd(lbuf.data[sb + LB_SPEC_ACC + 2u], uint(s.b * ACCUM_SCALE));
}
