#version 460 core
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// Edit invalidation. Dispatched (3D) over one padded EditRegion AABB per frame.
// For each lattice position, descends the octree to the resident leaf, builds its
// lBuffer key (pos, level, version) and — if the voxel is cached — re-sets its
// NormalUpdateFlag so normal.comp recomputes the (now stale) occupancy-derived
// normal. This covers neighbours of an edit whose own version did not change.

#include "lbuffer.glsl"

layout(std430, binding = SSBO_OCTREE_BINDING) readonly buffer OctreeBuffer { uvec2 nodes[]; } octree;

uniform uint  octreeDepth;
uniform uvec3 regionMin;
uniform uvec3 regionMax;

void main(){
    uvec3 p = regionMin + gl_GlobalInvocationID.xyz;
    if (p.x > regionMax.x || p.y > regionMax.y || p.z > regionMax.z) return;
    uint L = 1u << octreeDepth;
    if (p.x >= L || p.y >= L || p.z >= L) return;

    // Descend to the resident leaf at p → its level + version.
    uint block = octree.nodes[0].y;
    uint level = 0u, version = 0u, nodeLo = 0u;
    bool found = false;
    for (uint lev = 1u; lev <= octreeDepth; lev++){
        uint p2  = L >> lev;
        uint idx = (uint(bool(p.x & p2)) << 2u)
                 | (uint(bool(p.y & p2)) << 1u)
                 |  uint(bool(p.z & p2));
        uvec2 n = octree.nodes[block + idx];
        if (n.x == 0u && n.y == 0u) return;                 // empty cell
        if ((n.x & NODE_ISNODE_BIT) == 0u){                  // leaf
            if (((n.x >> NODE_MAT_SHIFT) & MATERIAL_MASK) == 0u) return;   // empty material
            level = lev; version = (n.x >> NODE_VER_SHIFT) & NODE_VER_MASK;
            nodeLo = n.x; found = true; break;
        }
        if (lev == octreeDepth) return;
        block = n.y;
    }
    if (!found) return;

    uint  vsize = L >> level;
    uvec3 vpos  = p & ~uvec3(vsize - 1u);                    // voxel origin = key position
    // These are an edit's NEIGHBOURS, mostly off-screen, so their baked offsets can predate
    // the last octree upload — probe fallback, or a missed flag leaves a stale normal.
    uint  slot  = findLBuffer(vpos, level, version, nodeLo);
    if (slot == LB_NO_SLOT) return;                          // not cached → nothing to flag
    atomicOr(lbuf.data[linearSlotToBase(slot) + LB_NORMAL], NORMAL_UPDATE_BIT);
}
